{
  "manifest_version": 3,
  "name": "axscope",
  "version": "0.1.1",
  "description": "Lets axscope drive this browser through chrome.debugger — with a rendered cursor.",
  "permissions": ["debugger", "tabs", "tabGroups", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "axscope",
    "default_popup": "popup.html"
  }
}
